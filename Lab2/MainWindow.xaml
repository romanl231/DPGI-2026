<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TextEditor" Height="450" Width="600">
     <Window.Resources>
        <LinearGradientBrush x:Key="LinearPanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Yellow" Offset="0"/>
            <GradientStop Color="SkyBlue" Offset="0.5"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10"
                Margin="4" Background="{StaticResource LinearPanelBrush}">
            <StackPanel Orientation="Horizontal" FocusManager.IsFocusScope="True">
                <Button ToolTip="Відкрити" Width="40" Height="40" Command="Open">
                    <iconPacks:PackIconMaterial Kind="FolderOpen"/>
                </Button>
                <Button ToolTip="Стерти" Width="40" Height="40" Command="Delete">
                    <iconPacks:PackIconMaterial Kind="Delete"/>
                </Button>
                <Button ToolTip="Копіювати" Width="40" Height="40" Command="Copy">
                    <iconPacks:PackIconMaterial Kind="ContentCopy"/>
                </Button>
                <Button ToolTip="Вставити" Width="40" Height="40" Command="Paste">
                    <iconPacks:PackIconMaterial Kind="ContentPaste"/>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10"
                Margin="4" Background="{StaticResource LinearPanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Name="txtDocument" Margin="8"
                         VerticalScrollBarVisibility="Visible"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontSize="{Binding ElementName=fontSlider, Path=Value}"/>

                <DockPanel Grid.Row="1" Margin="8">
                    <Label DockPanel.Dock="Left" VerticalAlignment="Center">Розмір шрифту:</Label>
                    <Slider Name="fontSlider" DockPanel.Dock="Left"
                            Margin="4" MinWidth="100"
                            Minimum="12" Maximum="100" Value="14"/>
                    <Button DockPanel.Dock="Right" Width="60"
                            Style="{x:Null}" Command="Save">OK</Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
