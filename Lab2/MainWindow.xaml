<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TextEditor" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="4">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Відкрити" Width="40" Height="40" Margin="4">
                    <iconPacks:PackIconMaterial Kind="FolderOpen"/>
                </Button>
                <Button ToolTip="Стерти" Width="40" Height="40" Margin="4">
                    <iconPacks:PackIconMaterial Kind="Delete"/>
                </Button>
                <Button ToolTip="Копіювати" Width="40" Height="40" Margin="4">
                    <iconPacks:PackIconMaterial Kind="ContentCopy"/>
                </Button>
                <Button ToolTip="Вставити" Width="40" Height="40" Margin="4">
                    <iconPacks:PackIconMaterial Kind="ContentPaste"/>
                </Button>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Name="txtDocument" Margin="8"
                         VerticalScrollBarVisibility="Visible"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <DockPanel Grid.Row="1" Margin="8">
                    <Button DockPanel.Dock="Right" Width="60">OK</Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
